VIDEO_TITLE=How a Learning System Updates
VIDEO_BRAND=RIT VIDEO LAB
VIDEO_OUTPUT=output/documentary
VIDEO_VOICE=en-US-AndrewMultilingualNeural
VIDEO_VOICE_RATE=+8%
VIDEO_VOICE_PITCH=-3Hz
VIDEO_VOICE_CONCURRENCY=4
VIDEO_RENDER_CONCURRENCY=2
VIDEO_MOTION=playful
VIDEO_FFMPEG=ffmpeg
VIDEO_FFPROBE=ffprobe
VIDEO_ENCODER_PRESET=veryfast
VIDEO_ENCODER_CRF=20

# Provider credentials are referenced by name from video.config.json.
# Leave these unset when using a fully local configuration.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional local bridge binary overrides.
PIPER_BIN=piper
WHISPER_CPP_BIN=whisper-cli

# Main pilot text planner: PrismML Bonsai 27B Q1_0 (binary 1-bit).
# Compute this from the separately downloaded Bonsai-27B-Q1_0.gguf file:
# shasum -a 256 /path/to/Bonsai-27B-Q1_0.gguf
BONSAI_27B_SHA256=
