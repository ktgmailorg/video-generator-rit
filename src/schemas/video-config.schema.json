{
  "$id": "https://github.com/ktgmailorg/video-generator-rit/schemas/video-config-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "preset",
    "project",
    "dataPolicy",
    "providers",
    "roles",
    "workflow"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "preset": {
      "enum": ["generic", "rit-course", "rit-student", "rit-media"]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "owner"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "courseCode": { "type": "string" },
        "department": { "type": "string" },
        "audience": { "type": "string" },
        "aiPolicyFile": { "type": "string" }
      }
    },
    "dataPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "hostedConsent",
        "allowedHostedProviders"
      ],
      "properties": {
        "classification": {
          "enum": ["public", "internal", "restricted"]
        },
        "hostedConsent": { "type": "boolean" },
        "allowedHostedProviders": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["adapter", "executionLocation"],
        "properties": {
          "adapter": { "type": "string", "minLength": 1 },
          "executionLocation": { "enum": ["local", "hosted"] },
          "baseUrl": { "type": "string" },
          "apiKeyEnv": { "type": "string" },
          "model": { "type": "string" },
          "voice": { "type": "string", "minLength": 1 },
          "voicePreset": { "enum": ["female", "male"] },
          "rate": { "type": "string", "minLength": 1 },
          "pitch": { "type": "string", "minLength": 1 },
          "capabilities": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primary", "fallbacks"],
        "properties": {
          "primary": { "type": "string", "minLength": 1 },
          "fallbacks": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groundingMode",
        "determinism",
        "approvals",
        "outputRoot",
        "maxCostUsd",
        "allowUnknownCost"
      ],
      "properties": {
        "groundingMode": {
          "enum": ["source-pack", "researched", "open"]
        },
        "determinism": { "enum": ["fresh", "record", "frozen"] },
        "approvals": {
          "type": "array",
          "items": { "enum": ["script", "visuals", "release"] },
          "uniqueItems": true
        },
        "outputRoot": { "type": "string", "minLength": 1 },
        "cacheRoot": { "type": "string", "minLength": 1 },
        "maxCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "allowUnknownCost": { "type": "boolean" }
      }
    },
    "brandPack": { "type": ["string", "null"] }
  }
}
